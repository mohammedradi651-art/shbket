PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-value
SMS_API_URL=https://star-sms.vercel.app/api/messages
SMS_API_KEY=replace-with-your-sms-provider-key
SMS_SENDER_NAME=وصل نت

# Set USE_FIREBASE=true only after adding server-side Firebase Admin credentials.
USE_FIREBASE=false
FIREBASE_SERVICE_ACCOUNT_PATH=server/firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
